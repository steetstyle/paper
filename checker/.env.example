# checker-app ayarları. Kopyalayıp .env yap: cp .env.example .env
# Her alt ayar kendi önekiyle okunur, isim çakışması olmaz.

# ---------------------------------------------------------------- genel
CHECKER_LANGUAGE=auto              # auto | tr | en
CHECKER_PROFILE=document           # document | thesis (tez: bolum rolleri + kurumsal filtreler)
CHECKER_MAX_CHARS=400000
CHECKER_DEFAULT_ENCODING=utf-8
CHECKER_LOG_LEVEL=INFO
CHECKER_DISCLAIMER=true           # rapor başına uyarı metni

# ------------------------------------------------------------ bölütleme
CHECKER_SEG_MIN_SENTENCE_CHARS=15  # bundan kısa parçalar önceki cümleye eklenir
CHECKER_SEG_SPLIT_INSIDE_QUOTES=false
CHECKER_SEG_TREAT_FORMFEED_AS_PAGE_BREAK=true
CHECKER_SEG_DETECT_LANGUAGE=true

# ------------------------------------------------------------- stilometri
CHECKER_STY_ENABLED=true
CHECKER_STY_LEXICON_LANGUAGES=["tr","en"]
CHECKER_STY_MIN_SENTENCE_WORDS=4

# ------------------------------------------------------------------- AI
CHECKER_AI_USE_PERPLEXITY=true
CHECKER_AI_USE_CLASSIFIER=true
CHECKER_AI_USE_RATIO=true
CHECKER_AI_MIN_AI_WORDS=12              # kisa cumleler olcumlenmez (AUROC 0.62/10 token)
CHECKER_AI_PERPLEXITY_MODEL_TR=ytu-ce-cosmos/turkish-gpt2
CHECKER_AI_PERPLEXITY_MODEL_EN=gpt2
# Likelihood-ratio'un ikinci (icra) modeli. Esikler dil bazlidir ve
# scripts/measure_ratio.py + `checker calibrate` ile olculmelidir.
CHECKER_AI_RATIO_MODEL_TR=hakanbogan/gpt2-turkish-cased
CHECKER_AI_RATIO_MODEL_EN=gpt2-large      # yayimlanmis cift (Binoculars esigi 0.901)
CHECKER_AI_CLASSIFIER_MODEL=Hello-SimpleAI/chatgpt-detector-roberta
CHECKER_AI_DEVICE=auto            # auto | cpu | cuda | cuda:0 | mps
CHECKER_AI_DTYPE=auto             # auto | float32 | float16 | bfloat16
CHECKER_AI_CONTEXT_SENTENCES=2   # perplexity kaç önceki cümleye bakarak ölçülsün
CHECKER_AI_MAX_CONTEXT_TOKENS=768
CHECKER_AI_BATCH_SIZE=8
CHECKER_AI_CLASSIFIER_CONTEXT_SENTENCES=1
CHECKER_AI_CLASSIFIER_MAX_LENGTH=512
# CHECKER_AI_CACHE_DIR=/path/to/huggingface/cache

# ---------------------------------------------------------------- intihal
CHECKER_PLAG_NGRAM_SIZE=4
CHECKER_PLAG_MIN_MATCH_WORDS=4
CHECKER_PLAG_NEAR_MATCH=true
CHECKER_PLAG_NEAR_MATCH_RATIO=0.85
CHECKER_PLAG_NEAR_MATCH_MIN_WORDS=12
CHECKER_PLAG_TEMPLATE_MATCH=true
CHECKER_PLAG_TEMPLATE_MIN_WORDS=12
CHECKER_PLAG_STRIP_DIACRITICS=true
CHECKER_PLAG_NORMALIZE_DIGITS=false
CHECKER_PLAG_CONTAINMENT_THRESHOLD=0.35
CHECKER_PLAG_CHECK_CODE=true
CHECKER_PLAG_INSTITUTIONAL_MIN_MATCH_WORDS=5   # "5 kelimeden az eslesmeler haric"
CHECKER_PLAG_EXCLUDE_REFERENCES=true           # "kaynakca haric"
CHECKER_PLAG_INCLUDE_QUOTES=true               # "alintilar dahil"
CHECKER_PLAG_MAX_SOURCE_CHARS=4000000
CHECKER_PLAG_CACHE_DIR=.checker_cache

# --------------------------------------------------------------- puanlama
# Agirliklar literatürdeki olcumlerden turetildi; gerekce LITERATURE.md §1.1
CHECKER_SCORE_WEIGHT_RATIO=0.34           # Binoculars/LRR: duzenlenmis insanda FPR %0.0-0.2
CHECKER_SCORE_WEIGHT_PERPLEXITY=0.08      # resmi metinde FPR %61-80 -> kucuk tera
CHECKER_SCORE_WEIGHT_CLASSIFIER=0.22
CHECKER_SCORE_WEIGHT_STYLOMETRY=0.20
CHECKER_SCORE_WEIGHT_UNIFORMITY=0.10
CHECKER_SCORE_SECTION_PRIOR_STRENGTH=1.0
CHECKER_SCORE_FPR_BUDGET=0.05             # esiklerin oturdugu isletim noktasi
CHECKER_SCORE_RATIO_SCALE=0.25
CHECKER_SCORE_PPL_CENTER_LOG10={"tr":1.50,"en":1.55}   # scripts/calibrate.py ile ölçüldü
CHECKER_SCORE_PPL_SCALE_LOG10={"tr":0.18,"en":0.18}
# Likelihood-ratio isletim noktasi (dil bazli, olculmus):
#   TR insan medyani 0.359 / AI 0.257 -> AUC 0.944, merkezde FPR %0
#   EN yayimlanmis esik 0.901 -> FPR %0
CHECKER_SCORE_RATIO_CENTER={"tr":0.33,"en":0.90}
CHECKER_SCORE_PPL_RELATIVE_WEIGHT=0.45
CHECKER_SCORE_PLAGIARISM_WEIGHT=0.85
CHECKER_SCORE_RISK_THRESHOLDS={"low":0.35,"medium":0.55,"high":0.75,"critical":0.90}