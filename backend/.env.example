# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=paper-app-backend
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Database (relational + pgvector)
#   production: postgresql+asyncpg://user:pass@host:5432/paper
#   local dev (no pg): sqlite+aiosqlite:///./.data/paper.db
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./.data/paper.db
DATABASE_SYNC_URL=sqlite:///./.data/paper.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Vector store backend: pgvector | qdrant | memory
# ---------------------------------------------------------------------------
VECTOR_BACKEND=pgvector
# Create a space's vector table + HNSW index idempotently on first use.
# Set false where schema changes must go through reviewed migrations, and
# apply `paper spaces sql <name>` inside one.
VECTOR_AUTO_CREATE=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=paper_chunks

# ---------------------------------------------------------------------------
# Embeddings: openai | sentence-transformers | hashing
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# One embedding space = one model = one table. `default` reuses the table
# created by migration 0001; any other name gets `embeddings__<name>`.
# Register extra models with `paper spaces add` rather than editing this.
EMBEDDING_SPACE=default
EMBEDDING_BATCH_SIZE=64
OPENAI_API_KEY=
OPENAI_BASE_URL=
ST_MODEL_CACHE_DIR=./.data/models

# ---------------------------------------------------------------------------
# ArXiv client
# ---------------------------------------------------------------------------
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_USER_AGENT=paper-app-backend/0.1 (mailto:you@example.com)
ARXIV_MAX_RESULTS_PER_REQUEST=100
ARXIV_REQUEST_INTERVAL_SECONDS=3.0
ARXIV_MAX_CONTENT_BYTES=100663296
ARXIV_ALLOW_AR5IV_FALLBACK=true
ARXIV_DOWNLOAD_DELAY_SECONDS=1.0

# ---------------------------------------------------------------------------
# MinerU (PDF -> Markdown)
#   Order is tried left to right until one yields usable text:
#     python_api = in-process API (needs `pip install 'paper-app-backend[mineru]'`)
#     cli        = `mineru` / `magic-pdf` binary on PATH
#     pypdf      = crude fallback so ingestion degrades instead of failing
#   MinerU's public API changed between major versions; the integration probes
#   the installed version and adapts (4.x doc_analyze, 2.x do_parse, 1.x legacy).
# ---------------------------------------------------------------------------
MINERU_BACKEND_ORDER=["python_api", "cli", "pypdf"]
MINERU_CLI_CANDIDATES=["mineru", "magic-pdf"]
MINERU_TIMEOUT_SECONDS=900
MINERU_KEEP_ARTIFACTS=false

# 2.x options (ignored on 4.x)
MINERU_BACKEND=pipeline
MINERU_LANGUAGE=en
MINERU_PARSE_METHOD=auto
MINERU_MODEL_SOURCE=huggingface
# MINERU_DEVICE=cuda:0
# MINERU_VRAM=8
# MINERU_SERVER_URL=http://127.0.0.1:30000
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# 4.x options (ignored on 2.x). tier: flash|basic|standard|advanced
# MINERU_TIER=standard
MINERU_EFFORT=high

# Extract figures and tables too. Off is text-only: cheaper, and it is what the
# embedding pipeline wants.
MINERU_EXTRACT_IMAGES=false

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
CHUNK_MIN_TOKENS=60
CHUNK_RESPECT_MARKDOWN=true

# ---------------------------------------------------------------------------
# Blob storage (content addressed, local filesystem or s3://)
# ---------------------------------------------------------------------------
STORAGE_ROOT=./.data/blobs
STORAGE_KEEP_DOWNLOADS=true

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
INGEST_CONCURRENCY=2
INGEST_EXTRACT_PDF_IMAGES=false